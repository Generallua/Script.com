RunService.RenderStepped:Connect(function()
    if player.Character and player.Character.PrimaryPart then
        local p = player.Character.PrimaryPart.Position
        posBtn.Text = string.format("POS: %.0f, %.0f, %.0f", p.X, p.Y, p.Z)
    end
    if not _G.F then
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            for _, v in ipairs(root:GetChildren()) do
                if v.Name == velocityName or v.Name == gyroName then v:Destroy() end
            end
        end
        return
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local bv = root:FindFirstChild(velocityName) or Instance.new("BodyVelocity", root)
    bv.Name = velocityName; bv.MaxForce = Vector3.one*9e9
    local bg = root:FindFirstChild(gyroName) or Instance.new("BodyGyro", root)
    bg.Name = gyroName; bg.MaxTorque = Vector3.one*9e9; bg.P=10000; bg.D=500
    bg.CFrame = camera.CFrame
    local success2, cm = pcall(function() return require(player.PlayerScripts.PlayerModule.ControlModule) end)
    local move = success2 and cm:GetMoveVector() or Vector3.zero
    local dir = camera.CFrame.RightVector * move.X + -camera.CFrame.LookVector * move.Z
    local vert = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert = vert + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vert = vert + Vector3.new(0,-1,0) end
    local target = (dir + vert).Unit * vehicleflyspeed
    if (dir+vert).Magnitude == 0 then target = Vector3.zero end
    bv.Velocity = bv.Velocity:Lerp(target, 0.2)
end)

