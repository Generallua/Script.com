local spectating = false
local prevCameraSubject = nil
local prevCameraType = nil

local function tryStopSpectate()
    if spectating then
        pcall(function()
            camera.CameraSubject = prevCameraSubject or player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") or camera.CameraSubject
            camera.CameraType = prevCameraType or Enum.CameraType.Custom
        end)
        spectating = false
        prevCameraSubject = nil
        prevCameraType = nil
    end
end

HybridBox.FocusLost:Connect(function(enter)
    if not enter then return end
    local txt = tostring(HybridBox.Text or "")
    txt = txt:match("^%s*(.-)%s*$") or txt
    if txt == "" then
        HybridBox.PlaceholderText = "INPUT EMPTY"
        return
    end

    -- find player by name / displayname (partial match allowed, case-insensitive)
    local tl = txt:lower()
    local targetPlayer = nil
    for _, pl in ipairs(Players:GetPlayers()) do
        local pname = (pl.Name or ""):lower()
        local dname = (pl.DisplayName or ""):lower()
        if pname == tl or dname == tl or pname:find(tl,1,true) or dname:find(tl,1,true) then
            targetPlayer = pl
            break
        end
    end

    local num = tonumber(txt)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
        -- start spectate
        pcall(function()
            if not spectating then
                prevCameraSubject = camera.CameraSubject
                prevCameraType = camera.CameraType
            end
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = targetPlayer.Character:FindFirstChild("Humanoid")
            spectating = true
            HybridBox.Text = ""
            HybridBox.PlaceholderText = "SPECTATING: " .. (targetPlayer.Name or "??")
            InputStroke.Color = Color3.fromRGB(0,255,0)
        end)
        task.wait(1)
        InputStroke.Color = Theme.Accent
        return
    end

    if num then
        -- number input stops spectate and sets fly speed
        tryStopSpectate()
        vehicleflyspeed = num
        if num > 0 then
            _G.F = true
            HybridBox.Text = ""
            HybridBox.PlaceholderText = "SPEED SET: " .. num
            InputStroke.Color = Color3.fromRGB(0,255,0)
        else
            _G.F = false
            HybridBox.Text = ""
            HybridBox.PlaceholderText = "SYSTEM IDLE"
            InputStroke.Color = Theme.Accent
        end
        task.wait(1)
        InputStroke.Color = Theme.Accent
        return
    end

    -- otherwise try run as code; running code also stops spectate (ตามที่ขอ)
    tryStopSpectate()
    local ok, func = pcall(function() return loadstring(txt) end)
    if ok and func then
        task.spawn(func)
        HybridBox.Text = ""
        HybridBox.PlaceholderText = "EXECUTED"
        InputStroke.Color = Color3.fromRGB(0,255,0)
    else
        HybridBox.Text = ""
        HybridBox.PlaceholderText = "SYNTAX ERROR"
        InputStroke.Color = Color3.fromRGB(255,0,0)
    end
    task.wait(1)
    InputStroke.Color = Theme.Accent
end)

